APP_LOGIN_PASSWORD=change-this-password
ANIU_IMAGE_TAG=latest

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

MX_APIKEY=
MX_API_URL=https://mkapi2.dfcfs.com/finskillshub

# ── UZI 深度报告（可选模块，默认启用）────────────────────────────
# 启用 UZI 模块（设为 false 可整体关闭，主服务仍正常启动）。
UZI_ENABLED=true
# Worker 内部地址（docker compose 内使用服务名）。
UZI_WORKER_URL=http://aniu-uzi-worker:9001
# 内部 API 共享密钥（必填，无默认弱值）：
# 必须与 aniu-uzi-worker 服务的 UZI_WORKER_TOKEN 保持一致。
# 同时需要把该值写入项目根目录 .env（或 shell export），供
# docker-compose.yml 变量插值注入 Worker。示例：UZI_WORKER_SHARED_SECRET=replace-with-a-long-random-secret
UZI_WORKER_SHARED_SECRET=
# 共享报告根目录（Worker 与主服务通过 ./data:/app/data 共享）。
UZI_REPORT_ROOT=/app/data/uzi_reports
# 主服务并发任务数（第一版固定为 1）。
UZI_MAX_ACTIVE=1
# 最大排队任务数。
UZI_MAX_QUEUED=3
# 整体任务超时（秒）。
UZI_JOB_TIMEOUT_SECONDS=3600
# Stage 2 综合与浏览器渲染的独立硬超时（秒）；超时会终止 Worker 子进程组。
UZI_STAGE2_TIMEOUT_SECONDS=600
# 单张 Playwright 分享图片的渲染超时（秒）；超时只跳过图片，不影响 HTML 报告。
UZI_RENDER_TIMEOUT_SECONDS=90
# Stage 2 量化风格识别最多查询的基金数；只影响可选风格标签。
UZI_QUANT_MAX_FUNDS=12
# 量化基金查询总超时（秒）；超时后跳过该标签并继续生成报告。
UZI_QUANT_TIMEOUT_SECONDS=45
# Worker 状态轮询间隔（秒）。
UZI_POLL_INTERVAL_SECONDS=2
# 同一来源创建任务的最小间隔（秒）。
UZI_CREATE_RATE_LIMIT_SECONDS=60

# 可选项：如果你希望容器重启或重建后保持登录态稳定，再手动取消注释并设置固定值。
# JWT_SECRET=replace-with-a-long-random-secret
# 可选项：如果你需要显式指定数据库路径，可取消注释并保持固定文件名。
# SQLITE_DB_PATH=/app/data/aniu.sqlite3
